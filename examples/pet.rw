/* RoseWind v0.2: whitespace is optional outside literals and comments. */
class(Pet) {
    pub(name:text);
    priv(age:num);

    create(name:text, age:num) {
        self.name = name;
        self.age = age;
    }

    pub(speak()->void) {
        print("Hi, I am " + self.name + "!");
    }
}

let(myDog:Pet = new(Pet, "Buddy", 3));
myDog.speak();