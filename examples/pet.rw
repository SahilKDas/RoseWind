/* RoseWind v0.3: whitespace is cosmetic outside literals and block comments. */
class(Pet) {
    name: text;
    priv(age: num);

    create(name: text, age: num) {
        self.name = name;
        self.age = age;
    }

    speak() {
        print("Hi, I am " + self.name + "!");
    }
}

let(myDog = new(Pet, "Buddy", 3));
myDog.speak();